# Desktop/daemon BYOK credentials. Prefer setting these through the UI credential store.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4
# Optional model capacities; context and maximum output are independent.
OPENAI_MAX_CONTEXT_TOKENS=
OPENAI_MAX_OUTPUT_TOKENS=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_CONTEXT_TOKENS=
ANTHROPIC_MAX_OUTPUT_TOKENS=
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-pro
GEMINI_MAX_CONTEXT_TOKENS=
GEMINI_MAX_OUTPUT_TOKENS=
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_PROMPT_BACKEND=auto
OPENAI_COMPATIBLE_MAX_CONTEXT_TOKENS=
OPENAI_COMPATIBLE_MAX_OUTPUT_TOKENS=
HARNESS_APP_PASSPHRASE=
HARNESS_APP_DATA_PATH=
HARNESS_BROWSER_EXECUTABLE=

# Independent limits for one conversation (no Redis service required)
HARNESS_TASK_CONCURRENCY=4
HARNESS_TASK_QUEUE_LENGTH=80
HARNESS_TOOL_CONCURRENCY=4
HARNESS_MODEL_CONCURRENCY=4

# Optional messaging connectors
TELEGRAM_BOT_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
HARNESS_REMOTE_WORKSPACE=

# Optional team gateway
HARNESS_GATEWAY_URL=http://127.0.0.1:8787
HARNESS_GATEWAY_TOKEN=
HARNESS_GATEWAY_MODEL=
HARNESS_GATEWAY_MAX_CONTEXT_TOKENS=
HARNESS_GATEWAY_MAX_OUTPUT_TOKENS=
GATEWAY_MASTER_KEY=
GATEWAY_ADMIN_KEY=
DATABASE_URL=postgres://harness:harness@postgres:5432/harness
