{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "noUncheckedSideEffectImports": false,
    "jsx": "react-jsx",
    "paths": {
      "@harness/protocol": ["./packages/protocol/src/index.ts"],
      "@harness/providers": ["./packages/providers/src/index.ts"],
      "@harness/persistence": ["./packages/persistence/src/index.ts"],
      "@harness/tools": ["./packages/tools/src/index.ts"],
      "@harness/tools/paths": ["./packages/tools/src/paths.ts"],
      "@harness/extensions": ["./packages/extensions/src/index.ts"],
      "@harness/core": ["./packages/core/src/index.ts"],
      "@harness/evals": ["./packages/evals/src/index.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "packages/**/*.tsx", "tests/**/*.ts", "vite.config.ts"]
}
